# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 GitHub에 올라가지 않는다.

# Gemini API 키 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 매일 확인할 사람인 검색결과 URL (사람인에서 조건을 걸고 '최신순'으로 정렬한 뒤 주소창 URL 복사, 따옴표 없이)
SEARCH_URL=

# 매일 가져올 목록 페이지 수와 본문 수집 최대 건수
DAILY_MAX_PAGES=2
DAILY_DETAIL_LIMIT=40

# 전체 훑기 모드(--full): 한 번에 받을 본문 수와 사이 휴식 시간(분)
FULL_BATCH=50
FULL_REST_MIN=20
